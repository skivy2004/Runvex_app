# Copy this file to .env.local and fill in the values from your Supabase dashboard
# (Project Settings -> API Keys). Never commit .env.local.

# Public: safe in the browser, data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
